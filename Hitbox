-- ============================================================
--  OPEN / CLOSE / MINIMIZE
-- ============================================================
local panelOpen = true
local panelMin  = false
local TI = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function OpenPanel()
    panelOpen = true; Panel.Visible = true
    TweenService:Create(Panel, TI, { Size = UDim2.new(0,PW,0,panelMin and 34 or PH) }):Play()
    SideTab.Text = "H\nI\nT\nB\nO\nX"; SideTab.BackgroundColor3 = Color3.fromRGB(30,15,65)
end

local function ClosePanel()
    panelOpen = false
    local t = TweenService:Create(Panel, TI, { Size = UDim2.new(0,0,0,PH) })
    t.Completed:Connect(function() if not panelOpen then Panel.Visible = false end end)
    t:Play()
    SideTab.Text = "â–¶"; SideTab.BackgroundColor3 = Color3.fromRGB(75,40,185)
end

local function SetMin(v)
    panelMin = v
    if v then
        Content.Visible = false
        TweenService:Create(Panel, TI, { Size = UDim2.new(0,PW,0,34) }):Play()
        MinBtn.Text = "â–¡"
    else
        TweenService:Create(Panel, TI, { Size = UDim2.new(0,PW,0,PH) }):Play()
        task.delay(0.15, function() Content.Visible = true end)
        MinBtn.Text = "â€”"
    end
end

SideTab.MouseButton1Click:Connect(function() if panelOpen then ClosePanel() else OpenPanel() end end)
CloseBtn.MouseButton1Click:Connect(ClosePanel)
MinBtn.MouseButton1Click:Connect(function() SetMin(not panelMin) end)

-- Drag
local drag, dStart, dOrigin = false, nil, nil
TBar.InputBegan:Connect(function(i)
    if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    if i.Target == MinBtn or i.Target == CloseBtn then return end
    drag = true; dStart = i.Position; dOrigin = Panel.Position
end)
TBar.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
end)
UserInputService.InputChanged:Connect(function(i)
    if not drag or i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
    local d = i.Position - dStart
    Panel.Position = UDim2.new(dOrigin.X.Scale, dOrigin.X.Offset+d.X, dOrigin.Y.Scale, dOrigin.Y.Offset+d.Y)
    SideTab.Position = UDim2.new(0, Panel.AbsolutePosition.X-35, 0, Panel.AbsolutePosition.Y+PH/2-40)
end)

