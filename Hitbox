--  ESP HIGHLIGHT
-- ============================================================
local function RemoveHL(char)
    if highlights[char] and highlights[char].Parent then highlights[char]:Destroy() end
    highlights[char] = nil
end

local function EnsureHL(char)
    if highlights[char] and highlights[char].Parent then return end
    local h = Instance.new("Highlight")
    h.Adornee=char; h.FillColor=Color3.fromRGB(255,50,50)
    h.OutlineColor=Color3.fromRGB(255,255,255)
    h.FillTransparency=0.55; h.OutlineTransparency=0
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent=char; highlights[char]=h
end

-- ============================================================
--  NAME TAGS
-- ============================================================
local function RemoveTag(char)
    if nameTags[char] and nameTags[char].Parent then nameTags[char]:Destroy() end
    nameTags[char] = nil
end

local function EnsureTag(char, player)
    if nameTags[char] and nameTags[char].Parent then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    local bb = Instance.new("BillboardGui")
    bb.Adornee=head; bb.AlwaysOnTop=true
    bb.Size=UDim2.new(0,105,0,40); bb.StudsOffset=Vector3.new(0,2.5,0)
    bb.ResetOnSpawn=false; bb.Parent=char

    local bg = Instance.new("Frame")
    bg.Size=UDim2.new(1,0,1,0); bg.BackgroundColor3=Color3.fromRGB(8,5,16)
    bg.BackgroundTransparency=0.3; bg.BorderSizePixel=0; bg.Parent=bb
    local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(0,5); c.Parent=bg

    local nl = Instance.new("TextLabel")
    nl.Size=UDim2.new(1,-4,0.58,0); nl.Position=UDim2.new(0,2,0,2)
    nl.BackgroundTransparency=1; nl.Text=player.DisplayName
    nl.TextColor3=Color3.fromRGB(255,70,70); nl.TextSize=9
    nl.Font=Enum.Font.GothamBold; nl.TextScaled=true; nl.Parent=bg

    local hpBg = Instance.new("Frame")
    hpBg.Name="HPBar"; hpBg.Size=UDim2.new(1,-4,0,5)
    hpBg.Position=UDim2.new(0,2,1,-8); hpBg.BackgroundColor3=Color3.fromRGB(35,6,6)
    hpBg.BorderSizePixel=0; hpBg.Parent=bg
    local c2=Instance.new("UICorner"); c2.CornerRadius=UDim.new(0,2); c2.Parent=hpBg

    local fill = Instance.new("Frame")
    fill.Name="Fill"; fill.Size=UDim2.new(1,0,1,0)
    fill.BackgroundColor3=Color3.fromRGB(80,220,80)
    fill.BorderSizePixel=0; fill.Parent=hpBg
    local c3=Instance.new("UICorner"); c3.CornerRadius=UDim.new(0,2); c3.Parent=fill

    nameTags[char]=bb
end

local function UpdateTag(char)
    local bb=nameTags[char]; if not bb or not bb.Parent then return end
    local hum=char:FindFirstChildOfClass("Humanoid"); if not hum then return end
    local pct=math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
    local bg=bb:FindFirstChildOfClass("Frame"); if not bg then return end
    local hpBg=bg:FindFirstChild("HPBar"); if not hpBg then return end
    local fill=hpBg:FindFirstChild("Fill"); if not fill then return end
    fill.Size=UDim2.new(pct,0,1,0)
    fill.BackgroundColor3=Color3.fromRGB(math.floor((1-pct)*220),math.floor(pct*220),25)
end

-- ============================================================
--  HEARTBEAT
-- ============================================================
RunService.Heartbeat:Connect(function()
    for _,player in ipairs(Players:GetPlayers()) do
        if player==LocalPlayer then continue end
        local char=player.Character; if not char then continue end
        local root=char:FindFirstChild("HumanoidRootPart"); if not root then continue end

        if hitboxEnabled then
            if not originalSizes[root] then originalSizes[root]=root.Size end
            root.Size=Vector3.new(HITBOX_SIZE,HITBOX_SIZE,HITBOX_SIZE)
        else
            if originalSizes[root] then root.Size=originalSizes[root]; originalSizes[root]=nil end
        end

        if hitboxEnabled or showBox then EnsureBox(char,root) else if hitboxBoxes[char] then RemoveBox(char) end end
        if espEnabled then EnsureHL(char) else if highlights[char] then RemoveHL(char) end end
        if nameTagEnabled then EnsureTag(char,player); UpdateTag(char) else if nameTags[char] then RemoveTag(char) end end
    end
    for char in pairs(hitboxBoxes)   do if not char.Parent then RemoveBox(char) end end
    for char in pairs(highlights)    do if not char.Parent then RemoveHL(char)  end end
    for char in pairs(nameTags)      do if not char.Parent then RemoveTag(char) end end
    for root in pairs(originalSizes) do if not root.Parent then originalSizes[root]=nil end end
end)

-- ============================================================
--  NOCLIP â€” Stepped runs before physics, most reliable for collision
-- ============================================================
RunService.Stepped:Connect(function()
    if not noclipEnabled then return end
    local myChar = LocalPlayer.Character
    if not myChar then return end
    for _, part in ipairs(myChar:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end)

-- ============================================================
--  CLICK DAMAGE
-- ============================================================
local Mouse = LocalPlayer:GetMouse()
Mouse.Button1Down:Connect(function()
    if not hitboxEnabled then return end
    local myChar=LocalPlayer.Character; if not myChar then return end
    local myRoot=myChar:FindFirstChild("HumanoidRootPart"); if not myRoot then return end
    local now=tick(); local hitRange=HITBOX_SIZE/2
    for _,player in ipairs(Players:GetPlayers()) do
        if player==LocalPlayer then continue end
        local char=player.Character; if not char then continue end
        local root=char:FindFirstChild("HumanoidRootPart")
        local hum=char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health<=0 then continue end
        if (myRoot.Position-root.Position).Magnitude<=hitRange then
            if now-(lastHitTime[player] or 0)>=HIT_COOLDOWN then
                lastHitTime[player]=now; hum:TakeDamage(DAMAGE)
            end
        end
    end
end)

