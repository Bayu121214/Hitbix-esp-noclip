local function UpdateStatus()
    local t = {}
    if hitboxEnabled  then t[#t+1] = "Hitbox"  end
    if showBox        then t[#t+1] = "Box"      end
    if espEnabled     then t[#t+1] = "ESP"      end
    if nameTagEnabled then t[#t+1] = "Tags"     end
    if noclipEnabled  then t[#t+1] = "Noclip"   end
    StatusLbl.Text = #t > 0 and ("ON: "..table.concat(t," | ")) or "All features OFF"
end

-- ============================================================
--  BOX
-- ============================================================
local function RemoveBox(char)
    if hitboxBoxes[char] and hitboxBoxes[char].Parent then hitboxBoxes[char]:Destroy() end
    hitboxBoxes[char] = nil
end

local function EnsureBox(char, root)
    if hitboxBoxes[char] and hitboxBoxes[char].Parent then
        hitboxBoxes[char].Size   = Vector3.new(HITBOX_SIZE,HITBOX_SIZE,HITBOX_SIZE)
        hitboxBoxes[char].CFrame = root.CFrame
        return
    end
    local b = Instance.new("Part")
    b.Name="HitboxBox"; b.Anchored=true; b.CanCollide=false; b.CanTouch=false
    b.CanQuery=false; b.Massless=true; b.CastShadow=false
    b.BrickColor=BrickColor.new("Bright red"); b.Material=Enum.Material.Neon
    b.Transparency=0.88; b.Size=Vector3.new(HITBOX_SIZE,HITBOX_SIZE,HITBOX_SIZE)
    b.CFrame=root.CFrame; b.Parent=workspace.CurrentCamera
    hitboxBoxes[char]=b
end

